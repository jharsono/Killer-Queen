{
  "name": "killer-queen-v2",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Modernized TypeScript + Vite rewrite of the Killer Queen 10-player arcade cover.",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=\"--import tsx/esm\" cucumber-js"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
